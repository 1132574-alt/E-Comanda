<?xml version="1.0" encoding="utf-8"?>

<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    android:elevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/txtMesaAviso"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="MESA 01"
            android:textColor="@android:color/black"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtTipoAviso"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="EL CLIENTE LLAMA AL CAMARERO"
            android:textColor="#E91E63"
            android:textSize="16sp"
            android:textStyle="italic" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp"
            android:gravity="end">

            <Button
                android:id="@+id/btnAtenderAviso"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="ATENDER"
                android:backgroundTint="#4CAF50" />

            <Button
                android:id="@+id/btnFinalizarMesa"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="COBRAR / CERRAR"
                android:backgroundTint="#2196F3" />

        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>