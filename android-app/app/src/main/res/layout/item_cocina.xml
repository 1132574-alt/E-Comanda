<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/txtMesaCocina"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Mesa: 00"
            android:textStyle="bold"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/txtEstadoPedidoCocina"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Estado: "
            android:textStyle="italic" />

        <TextView
            android:id="@+id/txtDetallePedidoCocina"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Detalle del pedido..." />

        <Button
            android:id="@+id/btnMarcarServido"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:text="LISTO / SERVIR" />
    </LinearLayout>
</androidx.cardview.widget.CardView>